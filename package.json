{
  "name": "@eave_bounty/dsh-workflow-studio",
  "version": "0.3.0",
  "description": "DSH 会话界面的可编排工作流：左侧 Plan/Action/Review/Loop 四类菜单栏 + 各类型可自定义 Agent，自由图模型画布，节点输入/输出多接口，连线与节点自动语义命名，对外 REST API 创建流程，多维度 Review 闭环，Apple 级动效。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "workflow",
    "plan-action-review",
    "node-graph",
    "react-flow",
    "xyflow",
    "agent-orchestration",
    "review"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EaveBounty/dsh-workflow-studio.git"
  },
  "homepage": "https://github.com/EaveBounty/dsh-workflow-studio",
  "bugs": {
    "url": "https://github.com/EaveBounty/dsh-workflow-studio/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./workflow": "./lib/workflow.js",
    "./tree": "./lib/tree.js",
    "./compile": "./lib/compile.js",
    "./semantics": "./lib/semantics.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node tests/workflow.test.mjs && node tests/tree.test.mjs && node tests/execute.test.mjs && node tests/semantics.test.mjs",
    "check": "node --check lib/index.js && node --check lib/workflow.js && node --check lib/client.js && node --check lib/tree.js && node --check lib/compile.js && node --check lib/semantics.js && node scripts/preflight.mjs",
    "prepack": "node scripts/preflight.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.7",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-workflow-worker-thread": "^0.1.0-rc.7"
  }
}
